# Server
PORT=3847
HOST=0.0.0.0
LOG_LEVEL=info

# Nostr Relays (comma-separated)
# These must match the relays in your BTCPay Nostr plugin settings
RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band

# Admin API authentication (generate with: openssl rand -hex 32)
ADMIN_TOKEN=change-this-to-a-secure-random-string

# Optional: Path to merchants config file (alternative to API registration)
MERCHANTS_FILE=./merchants.json

# --- Product Publishing (Shopstr/Nostr Marketplace) ---

# Your Nostr identity for signing product listings
# Must be 64-char hex format. Convert nsec to hex:
#   node -e "const {nip19} = require('nostr-tools'); console.log(Buffer.from(nip19.decode('nsec1...').data).toString('hex'))"
NOSTR_PRIVATE_KEY=
NOSTR_PUBKEY=

# WooCommerce REST API connection
# URL must match your WordPress siteurl exactly (not the server IP)
# Check with: wp option get siteurl
# API keys: WooCommerce > Settings > Advanced > REST API > Add key (Read/Write, Administrator)
WC_URL=https://shop.example.com
WC_CONSUMER_KEY=ck_your_consumer_key
WC_CONSUMER_SECRET=cs_your_consumer_secret

# Product listing defaults
LISTING_CURRENCY=USD
LISTING_LOCATION=Worldwide
